          ],
          "default": null,
          "title": "Grid Angle Deg"
        },
        "block_size_m": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Size M"
        },
        "height_m": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height M"
        },
        "water_separation": {
          "anyOf": [
            {
              "enum": [
                "water_preferred",
                "water_required",
                "none"
