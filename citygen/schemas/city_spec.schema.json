            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fraction of the land area. Missing shares split the remainder by archetype weight.",
          "title": "Area Share"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "seed": {
          "anyOf": [
            {
              "exclusiveMaximum": 2147483648,
              "minimum": 0,
              "type": "integer"
