{
  "$defs": {
    "Bridges": {
      "additionalProperties": false,
      "properties": {
        "density": {
          "default": 0.5,
          "description": "Road bridges per crossing opportunity.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Density",
          "type": "number"
        },
        "footbridge_density": {
          "default": 0.5,
          "description": "Low footbridges over canals.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Footbridge Density",
          "type": "number"
        },
        "transit_crossing": {
          "default": "auto",
          "description": "Transit lines on their own bridges or as a second deck.",
          "enum": [
            "own_bridge",
            "shared_deck",
            "auto"
          ],
          "title": "Transit Crossing",
          "type": "string"
        },
        "named": {
          "items": {
            "$ref": "#/$defs/NamedBridge"
          },
          "title": "Named",
          "type": "array"
        }
      },
      "title": "Bridges",
      "type": "object"
    },
    "Coast": {
      "additionalProperties": false,
      "properties": {
        "form": {
          "description": "Overall shape of the coast.",
          "enum": [
            "bay",
            "peninsula",
            "delta",
            "archipelago",
            "crescent",
            "straight"
          ],
          "title": "Form",
          "type": "string"
        },
        "side": {
          "description": "Side of the map where the open sea is.",
          "enum": [
            "north",
            "north_east",
            "east",
            "south_east",
            "south",
            "south_west",
            "west",
            "north_west"
          ],
          "title": "Side",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the sea or bay, e.g. 'West Bay'.",
          "title": "Name"
        },
        "sea_share": {
          "anyOf": [
            {
              "maximum": 0.8,
              "minimum": 0.05,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fraction of the map that is sea, offshore islands included (they are carved out of it). Default by form.",
          "title": "Sea Share"
        }
      },
      "required": [
        "form",
        "side"
      ],
      "title": "Coast",
      "type": "object"
    },
    "Complex": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "twin_towers",
            "tower_cluster",
            "megabuilding_campus",
            "bridged_pair",
            "straddle_building",
            "campus"
          ],
          "title": "Kind",
          "type": "string"
        },
        "count": {
          "default": 1,
          "maximum": 20,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Complex",
      "type": "object"
    },
    "District": {
