{
 "$defs": {
  "Ask": {
   "additionalProperties": false,
   "description": "An ask of another stage (scope 4.1): what lifegen needs that the model does not record\nyet, and what the plan derives meanwhile.",
   "properties": {
    "id": {
     "title": "Id",
     "type": "string"
    },
    "meanwhile": {
     "title": "Meanwhile",
     "type": "string"
    },
    "needed_by": {
     "description": "The milestone that first needs it.",
     "title": "Needed By",
     "type": "string"
    },
    "of": {
     "enum": [
      "citygen",
      "assetgen"
     ],
     "title": "Of",
     "type": "string"
    },
    "record": {
     "additionalProperties": true,
     "description": "The record asked for: field -> meaning.",
     "title": "Record",
     "type": "object"
    },
    "status": {
     "enum": [
      "missing",
      "derived",
      "met"
     ],
     "title": "Status",
     "type": "string"
    },
    "what": {
     "title": "What",
     "type": "string"
    }
   },
   "required": [
    "id",
    "of",
    "what",
    "record",
    "status",
    "meanwhile",
    "needed_by"
   ],
   "title": "Ask",
   "type": "object"
  },
  "Check": {
   "additionalProperties": false,
   "properties": {
    "detail": {
     "title": "Detail",
     "type": "string"
    },
    "ok": {
     "title": "Ok",
     "type": "boolean"
    }
   },
   "required": [
    "ok",
    "detail"
   ],
   "title": "Check",
   "type": "object"
  },
  "DistrictLife": {
   "additionalProperties": false,
   "description": "A district's people and vehicles by hour, from M11's densities and its filled spec.",
