{
 "$defs": {
  "Drive": {
   "additionalProperties": false,
   "description": "LG5: a lane's traffic (scope 6.5): how many cars drive on it in each of M11's hour bands\n(the district's day shapes the hours within a band), its road's class, and the signal it\nstops at.",
   "properties": {
    "district_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
