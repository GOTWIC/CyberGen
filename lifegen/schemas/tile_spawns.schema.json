     "title": "Owner Id",
     "type": "string"
    },
    "pos": {
     "items": {
      "type": "number"
     },
     "maxItems": 3,
     "minItems": 3,
     "title": "Pos",
     "type": "array"
    },
    "rates": {
     "description": "People a hour coming out (and as many going in).",
