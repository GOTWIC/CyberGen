     "items": {
      "type": "number"
     },
     "maxItems": 2,
     "minItems": 2,
     "title": "A",
     "type": "array"
    },
    "b": {
     "items": {
      "type": "number"
     },
     "maxItems": 2,
     "minItems": 2,
     "title": "B",
     "type": "array"
    },
    "ground_m": {
     "description": "The ground under its middle (absolute).",
     "title": "Ground M",
     "type": "number"
    },
    "hash": {
     "title": "Hash",
     "type": "string"
    },
    "id": {
     "description": "`<cover id>.drip<k>`.",
     "title": "Id",
     "type": "string"
    },
    "kind": {
